# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (protect secret credentials from public repository)
.env
.env*.local
.env.backup*
.env.production
!.env.example
!.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Desktop app (Electron - not part of web app)
/desktop-app

# Build logs & temp
build_output.txt
.agents
.temp/
supabase/.temp/
supabase/storage_backup/
supabase/*datos*.sql
supabase/MIGRACION_TOTAL.sql
supabase/fix_auth_and_user.sql
/scripts/
